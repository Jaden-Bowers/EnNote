{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "EnNote",
  "version": "0.1.0",
  "identifier": "com.ennote.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "EnNote",
        "width": 800,
        "height": 600,
        "minHeight": 400,
        "minWidth": 340,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "app": {
      "version": "latest"
    },
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "dialog": {
      "version": "latest"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "appimage", "deb", "dmg", "app"],
    "icon" : ["icons/icon.ico", "icons/icon.icns", "icons/128x128.png", "icons/32x32.png"]
  }
}
